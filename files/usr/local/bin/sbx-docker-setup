#!/usr/bin/env bash
# Startup hook of sbx-kit-docker: points dockerd at the mirror on the Mac and checks the image disk.
# It logs each failure and always exits 0: without the mirror, dockerd pulls from Docker Hub directly.
set -uo pipefail

port=${1:-}
warn_percent=${2:-80}
file=/etc/docker/daemon.json
log=/var/log/sbx-docker.log
mirror=http://host.docker.internal:$port

say() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $*" >>"$log"; }

# wait_for <seconds> <command...>
wait_for() {
  local end=$((SECONDS + $1))
  shift
  until "$@" >/dev/null 2>&1; do
    [ "$SECONDS" -lt "$end" ] || return 1
    sleep 0.5
  done
}

# shellcheck disable=SC2329 # called through wait_for
mirror_active() { docker info --format '{{json .RegistryConfig.Mirrors}}' | grep -qF "\"$mirror/\""; }

setup_mirror() {
  local current='{}' tmp
  if ! wait_for 30 docker info; then
    say "dockerd not ready after 30s"
    return
  fi
  mkdir -p /etc/docker
  if [ -s "$file" ] && ! current=$(jq -e 'if type == "object" then . else error end' "$file" 2>/dev/null); then
    say "invalid daemon.json, left as is"
    return
  fi
  if jq -e --arg m "$mirror" '.["registry-mirrors"] == [$m]' <<<"$current" >/dev/null; then
    say "unchanged daemon.json"
    return
  fi
  tmp=$(mktemp /etc/docker/daemon.json.XXXXXX) || return
  if ! jq --arg m "$mirror" '.["registry-mirrors"] = [$m]' <<<"$current" >"$tmp" || ! chmod 0644 "$tmp" ||
    ! mv "$tmp" "$file"; then
    rm -f "$tmp"
    say "write of daemon.json failed"
    return
  fi
  say "wrote daemon.json mirror $mirror"
  if ! pkill -HUP -x dockerd; then
    say "reload of dockerd failed"
    return
  fi
  say "reloaded dockerd"
  wait_for 10 mirror_active || say "mirror not active after 10s"
}

check_disk() {
  local used
  used=$(df --output=pcent /var/lib/docker 2>/dev/null | tail -1 | tr -dc 0-9)
  if [ -z "$used" ]; then
    say "disk use of /var/lib/docker unknown"
  elif [ "$used" -gt "$warn_percent" ]; then
    say "warn /var/lib/docker $used% full"
  fi
}

if [[ ! $port =~ ^[0-9]{4,5}$ ]] || [[ ! $warn_percent =~ ^[0-9]{1,3}$ ]]; then
  say "usage: sbx-docker-setup <port> [<warn percent>]"
  exit 0
fi
setup_mirror
check_disk
exit 0
